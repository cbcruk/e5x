{
  "name": "e5x",
  "version": "0.1.0",
  "description": "Shape-matched reactive interface over the DOM, in the spirit of E4X.",
  "keywords": [
    "dom",
    "e4x",
    "live-collection",
    "proxy",
    "reactive",
    "shape-matched"
  ],
  "license": "MIT",
  "author": "cbcruk <cbcruk@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx": {
      "types": "./dist/jsx.d.ts",
      "import": "./dist/jsx.js"
    }
  },
  "scripts": {
    "dev": "vp dev",
    "build": "tsc --noEmit && vp build",
    "build:demo": "vp build --config vite.demo.config.ts",
    "test": "vp test run --project happy-dom",
    "test:browser": "vp test run --project chromium",
    "test:watch": "vp test --project happy-dom",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "docs:check": "node scripts/doccheck.ts",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/browser-playwright": "4.1.11",
    "happy-dom": "^15.11.0",
    "playwright": "1.63.0",
    "typescript": "^5.6.3",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.0.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.22.0"
}
